# ── Firebase Admin (for leads + Firestore writes) ─────────────────────────────
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key

# ── Resend (primary transactional email provider) ─────────────────────────────
RESEND_API_KEY=your-resend-api-key

# ── Lead notification recipient ───────────────────────────────────────────────
# Email address that receives new-lead notifications from the website form.
# Set this in your deployment environment (Vercel / Cloud Run / local .env).
LEAD_NOTIFICATION_EMAIL=leads@ministrymotion.com

# ── Twilio (SMS notifications) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
SALES_ADMIN_PHONES=+1xxxxxxxxxx

# ── HubSpot CRM ───────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your-hubspot-pat

# ── Lead-intake spine primitive (Wave 1 reference integration — OFF by default) ──────────────
# See src/lib/lead-intake-shadow.ts + catalyst-platform PR #119/#127. When
# NEXT_PUBLIC_LEAD_INTAKE_SHADOW is unset or anything other than 'true', BetaSignupForm behaves
# EXACTLY as it does today (no extra request, no behavior change). Setting it to 'true' makes
# the form ALSO POST the same submission to the shared lead-intake Cloud Run service (running
# in its own shadow mode there — capture+log only, no email/CRM) for parity comparison, without
# touching the existing /api/leads path. All three are PUBLIC/non-secret (routing config, not
# credentials — CLAUDE.md §8).
# NEXT_PUBLIC_LEAD_INTAKE_SHADOW=true
# NEXT_PUBLIC_LEAD_SOURCE=ministrymotion
# NEXT_PUBLIC_LEAD_INTAKE_URL=https://lead-intake-<hash>-ue.a.run.app
